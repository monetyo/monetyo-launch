# -----------------------------------------------------------------
# Docker settings
#
# Rift derives these for every checkout and writes them into .env
# (see rift.yaml). It rewrites the values it manages and leaves the
# rest alone, so run `rift setup` rather than editing them by hand.
#
# Running with plain `docker compose` instead? Fill in GIT_COMMON_DIR
# with the absolute path printed by
#   git rev-parse --path-format=absolute --git-common-dir
# and set ASTRO_DEV_HMR_CLIENT_PORT to APP_PORT so hot reload works
# without the shared HTTPS router.
# -----------------------------------------------------------------

COMPOSE_PROJECT_NAME=monetyo-launch

BASE_NAME=monetyo-launch
BASE_DOMAIN=monetyo-launch.test

ROUTER_NAME=rift-router

CONTAINER_PORT=4321
APP_PORT=4321

# Absolute path of the shared git directory. Bind mounted into the
# container so git works inside git worktrees.
GIT_COMMON_DIR=

# Leave blank under Rift: Docker Compose sets it to 443 inside the
# container, where the browser reaches the shared router. For plain
# `docker compose`, set it to APP_PORT instead so hot reload works.
ASTRO_DEV_HMR_CLIENT_PORT=

# -----------------------------------------------------------------
# Cloudflare Turnstile
#
# Cloudflare's published test key, which always passes. The real one
# only works on the production domain and lives in Vercel.
# -----------------------------------------------------------------
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------
# Emailing the waitlist (`bun run notify`)
#
# Read from your shell, not from this file: export them and pass
# them in with `docker compose exec -e NOTIFY_SECRET ...`. The
# function itself reads NOTIFY_SECRET and NOTIFY_TEST_EMAIL from
# its Vercel environment.
# -----------------------------------------------------------------

# Bearer token api/notify requires. The same value as in Vercel.
NOTIFY_SECRET=

# Where `--test` sends one copy in each language. Set in Vercel only.
NOTIFY_TEST_EMAIL=

# Gets the script past Vercel's bot protection and, on a preview,
# Vercel Authentication. Vercel: Settings > Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Leave blank for production; set to a preview's /api/notify/ URL
# to try a send there first.
NOTIFY_URL=
