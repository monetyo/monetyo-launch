{
  "name": "monetyo-launch",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "prepare": "husky",
    "astro": "astro",
    "lint": "eslint .",
    "format:check": "prettier --check . && eslint .",
    "format": "eslint . --fix && prettier --write .",
    "check:audit": "bun audit --audit-level=high",
    "check:csp": "node check-csp.mjs",
    "check:type": "astro check",
    "dev": "astro dev",
    "build": "astro build && bun run check:csp",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "notify": "bun scripts/notify.ts"
  },
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,js,mjs,cjs,json,md,css,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@iconify-json/ph": "^1.2.2",
    "@monetyo/brand": "^0.1.1",
    "@neondatabase/serverless": "^1.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/functions": "^3.11.4",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "clsx": "^2.1.1",
    "eslint": "^10.16.0",
    "eslint-plugin-astro": "^3.2.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "~6",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  },
  "patchedDependencies": {
    "@alpinejs/csp@3.17.5": "patches/@alpinejs%2Fcsp@3.17.5.patch"
  }
}
