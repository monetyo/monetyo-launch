---
interface Props {
  /** The drawing's height; its width is always 1400. */
  height: number
  /** How far each circle sits in from its side of the drawing. */
  inset: number
  /** The circles' radius. */
  radius: number
  /**
   * How far below the bottom edge the circles' centres sit, which sets how
   * high they rise into the panel.
   */
  sink?: number
}

const { height, inset, radius, sink = 30 } = Astro.props

const WIDTH = 1400

// The circles rise from just below the bottom edge, a shade lighter and a
// shade darker than the blue, overlapping like the two coins of the mark.
const cy = height + sink
const viewBox = `0 0 ${WIDTH} ${height}`
const circles = [
  { animation: "animate-drift-a", cx: inset, fill: "fill-blue-400" },
  { animation: "animate-drift-b", cx: WIDTH - inset, fill: "fill-blue-600" },
]
---

{/* A layer per circle drifts on the GPU without repainting the panel, and draws
  past its box so a drift never shows a cut: the panel's edge crops it. */}
{circles.map(({ animation, cx, fill }) => (
  <svg
    aria-hidden="true"
    class={`absolute inset-0 size-full origin-bottom overflow-visible ${animation}`}
    preserveAspectRatio="xMidYMax slice"
    viewBox={viewBox}
  >
    <circle class={fill} cx={cx} cy={cy} r={radius} />
  </svg>
))}
