---
import type { HTMLAttributes } from "astro/types"

import lockup from "@monetyo/brand/logos/lockup.svg?url"

import { getSettings } from "@/libs/content"
import { cn } from "@/libs/utils"

interface Props extends HTMLAttributes<"img"> {
  size?: "md" | "sm"
}

const { class: className, size = "md", ...rest } = Astro.props

const { siteName } = await getSettings(Astro.currentLocale)
---

{/* An image rather than inline SVG, so the header and footer logos on one page
  never share the ids inside the file. Its height puts the mark at 24px (md)
  or 20px (sm), and the aspect ratio holds its width before it loads. */}
<img
  alt={siteName}
  class={cn(
    "block aspect-[11714/2454] w-auto",
    size === "md" ? "h-[1.534rem]" : "h-[1.278rem]",
    className
  )}
  src={lockup}
  {...rest}
/>
