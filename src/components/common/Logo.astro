---
import type { HTMLAttributes } from "astro/types"

import { Icon } from "astro-icon/components"

import { getSettings } from "@/libs/content"
import { cn } from "@/libs/utils"

interface Props extends HTMLAttributes<"span"> {
  size?: "md" | "sm"
}

const { class: className, size = "md", ...rest } = Astro.props

const { siteName } = await getSettings(Astro.currentLocale)
---

<span
  class={cn(
    "inline-flex items-center text-ink",
    size === "md" ? "gap-2.5" : "gap-[0.5625rem]",
    className
  )}
  {...rest}
>
  {/* Two coins overlapping: two people's money, counted as one. */}
  <Icon
    aria-hidden="true"
    class={size === "md" ? "h-5 w-[1.875rem]" : "h-4 w-6"}
    name="local:mark"
  />
  <span
    class={cn(
      "leading-none font-semibold tracking-[-0.04em]",
      size === "md" ? "text-[1.375rem]" : "text-[1.1875rem]"
    )}
  >
    {siteName.toLowerCase()}
  </span>
</span>
