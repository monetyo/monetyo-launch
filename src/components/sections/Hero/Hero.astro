---
import type { CollectionEntry } from "astro:content"

import BandMark from "@/components/common/BandMark.astro"

import HeroApp from "@/components/sections/Hero/HeroApp.astro"

import WaitlistForm from "@/components/sections/Waitlist/WaitlistForm.astro"

interface Props {
  home: CollectionEntry<"home">["data"]
}

const { app, hero } = Astro.props.home
---

{/* Pulled up under the header by its full height (36px + a 64px bar + 12px),
  so the panel's top edge sits 12px down, behind the bar, like its sides. */}
<section aria-labelledby="hero-heading" class="-mt-[7rem] px-3 pt-3">
  <div class="relative band bg-blue-500 text-white">
    <BandMark height={900} inset={330} radius={540} />

    <div class="relative flex flex-col items-center px-[clamp(1rem,4vw,3rem)] pt-[calc(5.5rem+clamp(3rem,4.6vw,4.125rem))] text-center">
      <h1 class="max-w-[13.5em] animate-enter display-1" id="hero-heading">
        {hero.heading.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </h1>

      <p class="mt-[1.375rem] max-w-[52em] animate-enter lead-hero text-balance [animation-delay:80ms]">
        {hero.lead}
      </p>

      <WaitlistForm
        class="mt-[2.125rem] max-w-[33.75rem] animate-enter [animation-delay:160ms]"
        id="hero"
      />

      <HeroApp app={app} />
    </div>
  </div>
</section>
