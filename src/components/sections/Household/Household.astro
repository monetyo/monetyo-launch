---
import type { CollectionEntry } from "astro:content"

import { Icon } from "astro-icon/components"

import { getAnchor } from "@/libs/i18n"
import { TINT_CLASSES } from "@/libs/palette"
import { cn } from "@/libs/utils"

interface Props {
  household: CollectionEntry<"home">["data"]["household"]
}

const { household } = Astro.props
const { budgets, currencies, sources, together } = household

const row =
  "flex flex-wrap items-center gap-x-[clamp(2.5rem,7vw,6.875rem)] gap-y-9"
const copy = "reveal flex min-w-0 flex-[1_1_22.5rem] flex-col gap-3.5"
const panel =
  "reveal min-w-0 flex-[1_1_25rem] rounded-3xl bg-white delay-150 text-[0.9375rem] leading-[1.35] shadow-[0_1px_2px_rgba(27,25,22,0.05),0_24px_48px_-24px_rgba(27,25,22,0.22)]"
const item = "flex items-center gap-3.5 border-sand-150 not-first:border-t"
const avatar =
  "flex h-10 flex-[0_0_2.5rem] items-center justify-center rounded-full text-[0.9375rem] font-semibold"
const card =
  "reveal flex min-w-0 flex-[1_1_25rem] flex-col justify-between gap-8 rounded-[1.75rem] bg-white p-[clamp(1.5rem,2.8vw,2.5rem)]"
const tile = "flex flex-col gap-[0.1875rem] rounded-2xl p-4"

// How each way in is marked, in the list and on the payments it brings.
const SOURCES = {
  bank: { icon: "ph:bank", tint: "bg-blue-50 text-blue-600" },
  file: { icon: "ph:file-csv", tint: "bg-sand-150 text-ink" },
  hand: { icon: "ph:pencil-simple-line", tint: "bg-coral-50 text-coral-800" },
  receipt: { icon: "ph:receipt", tint: "bg-green-50 text-green-700" },
} as const

// The payments land one after another once the panel is in view.
const ARRIVE = ["delay-300", "delay-[450ms]", "delay-[600ms]", "delay-[750ms]"]

const KINDS = {
  expense: { amount: "font-medium", icon: undefined, tint: "bg-blue-50" },
  refund: {
    amount: "font-semibold text-green-700",
    icon: "local:refund",
    tint: "bg-green-50 text-green-700",
  },
  transfer: {
    amount: "font-medium text-sand-700",
    icon: "local:transfer",
    tint: "bg-sand-100 text-ink",
  },
} as const
---

<section class="section" id={getAnchor("household", Astro.currentLocale)}>
  <div class="container-page">
    <div class="reveal flex max-w-measure flex-col gap-[1.125rem]" data-reveal>
      <h2 class="heading-2">{household.heading}</h2>
      <p class="max-w-[34em] lead text-sand-750">{household.lead}</p>
    </div>

    <div class={cn(row, "mt-intro")}>
      <div class={copy} data-reveal>
        <h3 class="heading-4">{together.heading}</h3>
        <p class="max-w-[30em] body-2 text-sand-750">{together.body}</p>
      </div>
      <div
        aria-label={together.label}
        class={cn(panel, "px-[1.375rem] pt-2 pb-3")}
        data-reveal
        role="img"
      >
        <div class="flex items-center justify-between pt-3.5 pb-3">
          <span class="text-base font-semibold">{together.title}</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-ink px-3.5 py-[0.4375rem] text-[0.84375rem] font-medium text-white">
            <Icon class="size-3" name="local:plus" />
            {together.invite}
          </span>
        </div>
        {together.members.map(
          ({ description, initial, name, owner, role, tint }) => (
            <div class={cn(item, "border-t py-3.5")}>
              <span class={cn(avatar, TINT_CLASSES[tint])}>{initial}</span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="font-medium">{name}</span>
                <span class="text-[0.84375rem] text-sand-700">
                  {description}
                </span>
              </span>
              {owner ? (
                <span class="rounded-full bg-sand-100 px-3 py-1.5 text-[0.84375rem] font-medium">
                  {role}
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-sand-350 py-1.5 pr-2.5 pl-3 text-[0.84375rem] font-medium">
                  {role}
                  <Icon
                    class="size-3 text-sand-700"
                    name="local:chevron-down"
                  />
                </span>
              )}
            </div>
          )
        )}
      </div>
    </div>

    <div class={cn(row, "mt-[clamp(4rem,7vw,6rem)] flex-row-reverse")}>
      <div class={copy} data-reveal>
        <h3 class="heading-4">{budgets.heading}</h3>
        <p class="max-w-[30em] body-2 text-sand-750">{budgets.body}</p>
      </div>
      <div
        aria-label={budgets.label}
        class={cn(panel, "px-[1.375rem] py-2 tabular-nums")}
        data-reveal
        role="img"
      >
        {budgets.items.map(({ amount, detail, initial, kind, name }) => (
          <div class={cn(item, "py-4")}>
            <span class={cn(avatar, KINDS[kind].tint)}>
              {KINDS[kind].icon ? (
                <Icon class="size-[1.125rem]" name={KINDS[kind].icon} />
              ) : (
                initial
              )}
            </span>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="font-medium">{name}</span>
              <span class="text-[0.84375rem] text-sand-700">{detail}</span>
            </span>
            <span class={cn("whitespace-nowrap", KINDS[kind].amount)}>
              {amount}
            </span>
          </div>
        ))}
      </div>
    </div>

    {/* The four ways in, beside the one list they all end up in: each
      payment carries a badge saying how it arrived. */}
    <div class={cn(row, "mt-[clamp(4rem,7vw,6rem)]")}>
      <div class={copy} data-reveal>
        <h3 class="heading-4">{sources.heading}</h3>
        <p class="max-w-[30em] body-2 text-sand-750">{sources.body}</p>
        <ul class="mt-3 grid gap-x-6 gap-y-5 sm:grid-cols-2">
          {sources.items.map(({ id, name, note }) => (
            <li class="flex items-center gap-3.5">
              <span
                class={cn(
                  "flex size-10 flex-none items-center justify-center rounded-full",
                  SOURCES[id].tint
                )}
              >
                <Icon
                  aria-hidden="true"
                  class="size-5"
                  name={SOURCES[id].icon}
                />
              </span>
              <span class="flex flex-col">
                <span class="font-medium">{name}</span>
                <span class="text-sm text-sand-750">{note}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div
        aria-label={sources.label}
        class={cn(panel, "px-[1.375rem] pt-4 pb-2 tabular-nums")}
        data-reveal
        role="img"
      >
        <p class="pb-2 font-semibold">{sources.title}</p>
        {sources.rows.map(
          ({ amount, detail, initial, name, source, tint }, index) => (
            <div class={cn(item, "appear py-4", ARRIVE[index % ARRIVE.length])}>
              <span class={cn(avatar, TINT_CLASSES[tint])}>{initial}</span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="font-medium">{name}</span>
                <span class="text-[0.84375rem] text-sand-700">{detail}</span>
              </span>
              <span class="flex flex-col items-end gap-1">
                <span class="font-medium whitespace-nowrap">{amount}</span>
                <span
                  class={cn(
                    "flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium",
                    SOURCES[source].tint
                  )}
                >
                  <Icon
                    aria-hidden="true"
                    class="size-3.5"
                    name={SOURCES[source].icon}
                  />
                  {sources.items.find((way) => way.id === source)?.badge}
                </span>
              </span>
            </div>
          )
        )}
      </div>
    </div>

    <div class="mt-[clamp(3.5rem,6vw,5rem)] flex flex-wrap gap-5">
      <div
        class={cn(card, "flex-row flex-wrap items-center justify-between")}
        data-reveal
      >
        <div class="flex max-w-[30rem] flex-col gap-2.5">
          <h3 class="heading-5">{currencies.heading}</h3>
          <p class="text-sand-750">{currencies.body}</p>
        </div>
        <div class="flex min-w-0 flex-[0_1_28rem] items-center gap-3 leading-[1.3] tabular-nums">
          <div class={cn(tile, "min-w-0 flex-1 bg-sand-100")}>
            <span class="text-[0.84375rem] text-sand-750">
              {currencies.from.label}
            </span>
            <span class="text-2xl font-semibold tracking-[-0.03em]">
              {currencies.from.amount}
            </span>
          </div>
          <Icon
            aria-hidden="true"
            class="appear h-3.5 w-[1.375rem] flex-none delay-[450ms]"
            name="local:arrow-right"
          />
          <div
            class={cn(tile, "appear min-w-0 flex-1 bg-blue-50 delay-[700ms]")}
          >
            <span class="text-[0.84375rem] text-sand-800">
              {currencies.to.label}
            </span>
            <span class="text-2xl font-semibold tracking-[-0.03em]">
              {currencies.to.amount}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
