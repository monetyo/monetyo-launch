---
import type { CollectionEntry } from "astro:content"

import BandCircles from "@/components/common/BandCircles.astro"

import WaitlistForm from "@/components/sections/Waitlist/WaitlistForm.astro"

import { getAnchor } from "@/libs/i18n"

interface Props {
  join: CollectionEntry<"home">["data"]["join"]
}

const { join } = Astro.props
---

<section
  aria-labelledby="join-heading"
  class="px-3 pt-section"
  id={getAnchor("join", Astro.currentLocale)}
>
  <div class="relative band bg-blue-500 text-white">
    <BandCircles height={560} inset={410} radius={420} sink={100} />
    <div
      class="reveal relative flex flex-col items-center px-[clamp(1rem,4vw,3rem)] py-[clamp(3.25rem,5.4vw,4.875rem)] text-center"
      data-reveal
    >
      <h2 class="max-w-[12em] display-2" id="join-heading">
        {join.heading}
      </h2>
      <p class="mt-[1.375rem] max-w-[31em] lead-hero text-balance">
        {join.lead}
      </p>
      <WaitlistForm class="mt-[2.125rem] max-w-[33.75rem]" id="join" />
    </div>
  </div>
</section>
