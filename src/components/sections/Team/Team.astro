---
import type { CollectionEntry } from "astro:content"

import { Icon } from "astro-icon/components"

import Portrait from "@/components/sections/Team/Portrait.astro"

import { cn } from "@/libs/utils"

interface Props {
  team: CollectionEntry<"home">["data"]["team"]
}

const { team } = Astro.props

// Each Polaroid hangs from its own magnet, a little crooked, the same way
// the notes on the roadmap's fridge do.
const MAGNET = {
  joan: "bg-green-500",
  luca: "bg-blue-500",
  susanna: "bg-coral-500",
} as const

const TILT = ["-rotate-2", "rotate-[1.5deg]", "-rotate-1"]

// They land one after another once the row is in view.
const STAGGER = [
  "[animation-delay:150ms]",
  "[animation-delay:300ms]",
  "[animation-delay:450ms]",
]
---

<section aria-labelledby="team-heading" class="section">
  <div class="container-page">
    <div
      class="reveal flex flex-wrap items-end justify-between gap-x-16 gap-y-5"
      data-reveal
    >
      <div class="flex max-w-[34rem] flex-col gap-4">
        <p class="eyebrow text-coral-700">{team.eyebrow}</p>
        <h2 class="heading-2" id="team-heading">
          {team.heading}
        </h2>
      </div>
      <p class="max-w-[26rem] lead text-sand-750">{team.lead}</p>
    </div>

    <ul
      class="mt-intro grid gap-x-[clamp(1.5rem,3vw,2.75rem)] gap-y-16 pt-4 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal
    >
      {team.members.map(({ bio, id, name, owns, role, url }, index) => (
        <li class="group flex flex-col gap-6">
          {/* The Polaroid: the portrait, and the name written underneath. */}
          <div
            class={cn(
              "stick relative mx-auto w-full max-w-[20rem] rounded-[0.375rem] bg-white p-3 pb-0 shadow-[0_1px_2px_rgba(27,25,22,0.08),0_22px_40px_-22px_rgba(27,25,22,0.45)] transition-[rotate,translate,box-shadow] duration-500 ease-out-expo group-focus-within:-translate-y-2 group-focus-within:rotate-0 group-hover:-translate-y-2 group-hover:rotate-0 group-hover:shadow-[0_2px_3px_rgba(27,25,22,0.08),0_30px_48px_-22px_rgba(27,25,22,0.5)]",
              TILT[index % TILT.length],
              STAGGER[index % STAGGER.length]
            )}
          >
            <span
              aria-hidden="true"
              class={cn(
                "absolute -top-2.5 left-1/2 z-10 size-5 -translate-x-1/2 rounded-full shadow-[inset_0_-2px_3px_rgba(0,0,0,0.25),inset_0_2px_2px_rgba(255,255,255,0.55),0_3px_6px_rgba(27,25,22,0.35)]",
                MAGNET[id]
              )}
            />
            <div class="aspect-square overflow-hidden rounded-[0.1875rem]">
              <Portrait id={id} />
            </div>
            <div class="flex items-baseline justify-between gap-3 px-1.5 pt-4 pb-5">
              <h3 class="text-[1.5rem] leading-none font-medium tracking-[-0.025em]">
                {name}
              </h3>
              <p class="text-right text-sm font-medium text-sand-750">{role}</p>
            </div>
          </div>

          <div class="mx-auto flex w-full max-w-[20rem] flex-1 flex-col gap-4">
            <p class="text-[0.96875rem] leading-normal text-sand-750">{bio}</p>
            <ul aria-label={role} class="flex flex-wrap gap-1.5">
              {owns.map((area) => (
                <li class="rounded-full bg-white px-2.5 py-1 text-xs font-medium whitespace-nowrap shadow-[0_1px_2px_rgba(27,25,22,0.08)]">
                  {area}
                </li>
              ))}
            </ul>
            <a
              aria-label={team.linkedin.replace("{name}", name)}
              class="mt-auto inline-flex items-center gap-2 self-start rounded-full py-1 text-[0.9375rem] font-medium text-blue-500 hover:text-blue-600"
              href={url}
              rel="noopener noreferrer"
              target="_blank"
            >
              <Icon aria-hidden="true" class="size-5" name="ph:linkedin-logo" />
              LinkedIn
              <Icon
                aria-hidden="true"
                class="size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                name="ph:arrow-up-right"
              />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
