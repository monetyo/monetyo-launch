---
import type { CollectionEntry } from "astro:content"

import LegalPage from "@/components/legal/LegalPage.astro"

import { getLocalizedStaticPaths } from "@/libs/content"

/**
 * Builds the page in every language, each at its translated path.
 */
export async function getStaticPaths() {
  return getLocalizedStaticPaths("privacy", "privacy")
}

interface Props {
  entry: CollectionEntry<"privacy">
}
---

<LegalPage data={Astro.props.entry.data} path="/privacy/" />
