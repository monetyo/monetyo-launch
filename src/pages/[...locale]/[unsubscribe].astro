---
import type { CollectionEntry } from "astro:content"

import Layout from "@/layouts/main.astro"

import EmailAction from "@/components/sections/EmailAction/EmailAction.astro"

import { getLocalizedStaticPaths } from "@/libs/content"
import { getAlternates } from "@/libs/i18n"

/**
 * Builds the page in every language, each at its translated path.
 */
export async function getStaticPaths() {
  return getLocalizedStaticPaths("unsubscribe", "unsubscribe")
}

interface Props {
  entry: CollectionEntry<"unsubscribe">
}

const { data } = Astro.props.entry
---

<Layout
  alternates={getAlternates("/unsubscribe/")}
  description={data.description}
  noindex
  title={data.title}
>
  <EmailAction
    copy={{
      ...data,
      failedBody: data.invalidBody,
      failedHeading: data.invalidHeading,
    }}
    endpoint="/api/unsubscribe/"
  />
</Layout>
